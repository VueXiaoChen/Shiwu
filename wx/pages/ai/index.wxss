/**
 * AI 找物助手页样式 — 轻盈聊天风（悬浮输入栏版）
 *
 * 依旧遵守：无紫色、无渐变、淡色系、浅阴影、无 emoji
 */

 .page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  position: relative;
  background: #f6f7f9;
}

/* ============================================
   消息列表
   ============================================ */
.msg-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

/* 顶部提示 */
.ai-tip {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.ai-tip-text {
  font-size: 21rpx;
  color: #9aa3ad;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

/* 消息行 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 36rpx;
}

.msg-row-me {
  flex-direction: row-reverse;
}

/* AI 头像 */
.ai-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #ffffff;
  border: 1rpx solid rgba(74, 144, 217, 0.18);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-avatar-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #4a90d9;
  letter-spacing: 1rpx;
}

.msg-bubble-wrap {
  display: flex;
  flex-direction: column;
  max-width: 78%;
  margin: 0 18rpx;
}

.msg-row-me .msg-bubble-wrap {
  align-items: flex-end;
}

/* 气泡 */
.msg-bubble {
  position: relative;
  padding: 20rpx 26rpx;
  background: #ffffff;
  border-radius: 4rpx 20rpx 20rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.msg-bubble-me {
  background: #4a90d9;
  border-radius: 20rpx 4rpx 20rpx 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(74, 144, 217, 0.28);
}

.msg-text {
  font-size: 27rpx;
  line-height: 1.6;
  color: #1f2329;
  word-break: break-all;
  white-space: pre-line;
}

.msg-bubble-me .msg-text {
  color: #ffffff;
}

/* ============================================
   消息中的图片
   ============================================ */
.msg-image-wrap {
  margin-top: 16rpx;
  max-width: 320rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.msg-image {
  width: 100%;
  display: block;
  border-radius: 14rpx;
}

/* ============================================
   匹配物品卡片
   ============================================ */
.match-list {
  margin-top: 18rpx;
  width: 100%;
}

.match-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border: 1rpx solid #eef0f3;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.match-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.match-thumb {
  width: 108rpx;
  height: 108rpx;
  border-radius: 16rpx;
  background: #f2f4f7;
  flex-shrink: 0;
}

.match-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.match-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.match-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.match-tag {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.match-tag-found {
  color: #4a90d9;
  background: rgba(74, 144, 217, 0.12);
}

.match-tag-lost {
  color: #d48806;
  background: rgba(212, 136, 6, 0.12);
}

.match-loc {
  font-size: 22rpx;
  color: #8a9099;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.match-time {
  display: block;
  font-size: 20rpx;
  color: #b3b8c0;
  margin-top: 10rpx;
}

.match-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #c5cad1;
  border-right: 3rpx solid #c5cad1;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* ============================================
   引导操作按钮
   ============================================ */
.action-btn {
  align-self: flex-start;
  margin-top: 16rpx;
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4a90d9;
  background: rgba(74, 144, 217, 0.1);
  border: 1rpx solid rgba(74, 144, 217, 0.28);
  border-radius: 999rpx;
  transition: all 0.15s ease;
}

.action-btn:active {
  background: rgba(74, 144, 217, 0.18);
}

/* ============================================
   快捷提问
   ============================================ */
.quick-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 22rpx;
  width: 100%;
}

.quick-label {
  font-size: 22rpx;
  color: #b3b8c0;
  margin-bottom: 14rpx;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.quick-chip {
  padding: 14rpx 28rpx;
  font-size: 25rpx;
  color: #4a5560;
  background: #ffffff;
  border: 1rpx solid #e7eaee;
  border-radius: 999rpx;
  transition: all 0.15s ease;
}

.quick-chip:active {
  color: #4a90d9;
  background: rgba(74, 144, 217, 0.08);
  border-color: rgba(74, 144, 217, 0.3);
}

/* ============================================
   AI 思考中动画
   ============================================ */
.thinking-bubble {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 30rpx;
}

.think-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4a90d9;
  opacity: 0.3;
  animation: think-blink 1.2s infinite;
}

.think-dot-2 {
  animation-delay: 0.2s;
}

.think-dot-3 {
  animation-delay: 0.4s;
}

@keyframes think-blink {
  0%, 100% { opacity: 0.3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-6rpx); }
}

/* 底部留白：给悬浮输入栏让出空间 */
.msg-scroll-pad {
  height: 180rpx;
}

/* ============================================
   底部输入栏（悬浮胶囊，强制水平居中）
   ============================================ */
.input-bar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  width: 694rpx;
  max-width: calc(100% - 56rpx);
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0;
  background: #ffffff;
  border: 1rpx solid #e7eaee;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.1);
  z-index: 20;
  box-sizing: border-box;
}

/* 输入区外壳 */
.input-shell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding-left: 10rpx;
  padding-right: 10rpx;
}

/* 上传按钮 */
.upload-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f4f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn:active {
  background: #e8ebef;
}

/* 加号 */
.upload-icon {
  position: relative;
  width: 22rpx;
  height: 22rpx;
}

.upload-icon-h {
  position: absolute;
  top: 50%;
  left: 0;
  width: 22rpx;
  height: 4rpx;
  margin-top: -2rpx;
  border-radius: 2rpx;
  background: #4a90d9;
}

.upload-icon-v {
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 22rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: #4a90d9;
}

/* 输入框外层 */
.input-wrap {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
}

/* 输入框本体：高度 auto，由外层 flex 垂直居中 */
.input-field {
  flex: 1;
  min-width: 0;
  height: auto;
  padding: 0 16rpx;
  font-size: 27rpx;
  color: #1f2329;
  background: transparent;
}

/* 发送键 */
.send-btn {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #c5cad1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, transform 0.15s ease;
}

.send-btn:active {
  transform: scale(0.92);
}

.send-btn-active {
  background: #4a90d9;
  box-shadow: 0 6rpx 16rpx rgba(74, 144, 217, 0.35);
}

/* 发送箭头 */
.send-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid #ffffff;
  border-right: 4rpx solid #ffffff;
  transform: rotate(45deg) translate(-2rpx, 2rpx);
}

/* ============================================
   已选图片预览条
   ============================================ */
.preview-bar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  width: 694rpx;
  max-width: calc(100% - 56rpx);
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid #e7eaee;
  border-radius: 20rpx;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 19;
  box-sizing: border-box;
}

.preview-item {
  position: relative;
  flex-shrink: 0;
}

.preview-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 14rpx;
  background: #f2f4f7;
}

.preview-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.preview-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #8a9099;
  line-height: 1.4;
}