/**
 * 对话页样式 — 淡色极简风
 */

.page {
  /* 全局 page 关闭了页面级滚动，本页用 flex 纵向布局：物品卡 + 消息区 + 输入栏 */
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* ============================================
   顶部关联物品卡
   ============================================ */
.item-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.item-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm, 6rpx);
  background: var(--color-bg-page);
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.item-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-bottom: 10rpx;
}

.item-meta {
  display: flex;
  align-items: center;
}

.item-type-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--radius-sm, 6rpx);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tag-found {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.tag-lost {
  color: var(--color-warning);
  background: #fdf6e7;
}

.item-loc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.item-contact-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
  border-radius: var(--radius-full, 999rpx);
  padding: 8rpx 24rpx;
}

/* ============================================
   消息气泡列表
   ============================================ */
.msg-scroll {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 沟通提示 */
.chat-tip {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.chat-tip-text {
  font-size: 21rpx;
  color: var(--color-text-placeholder);
  background: var(--color-border-light);
  border-radius: var(--radius-full, 999rpx);
  padding: 8rpx 24rpx;
}

/* 消息行：对方在左，我在右 */
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.msg-row-me {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-bg-page);
  flex-shrink: 0;
}

.msg-bubble-wrap {
  display: flex;
  flex-direction: column;
  max-width: 70%;
  margin: 0 18rpx;
}

.msg-row-me .msg-bubble-wrap {
  align-items: flex-end;
}

.msg-bubble {
  padding: 18rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: 4rpx 20rpx 20rpx 20rpx;
}

.msg-bubble-me {
  background: var(--color-primary);
  border-radius: 20rpx 4rpx 20rpx 20rpx;
}

.msg-text {
  font-size: 27rpx;
  line-height: 1.6;
  color: var(--color-text-primary);
  word-break: break-all;
}

.msg-bubble-me .msg-text {
  color: #fff;
}

.msg-time {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
  margin-top: 10rpx;
}

/* 空会话引导 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.chat-empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.chat-empty-hint {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

/* 底部留白，防止最后一条消息贴住输入栏 */
.msg-scroll-pad {
  height: 24rpx;
}

/* ============================================
   底部输入栏
   ============================================ */
.input-bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-card);
  border-top: 1rpx solid var(--color-border-light);
}

.input-field {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  border-radius: var(--radius-full, 999rpx);
}

.send-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 27rpx;
  color: #fff;
  background: var(--color-text-placeholder);
  border-radius: var(--radius-full, 999rpx);
  transition: background 0.2s;
}

.send-btn-active {
  background: var(--color-primary);
}
