/**
 * 我的发布样式
 *
 * 布局：吸顶状态 Tab + 单列信息卡片（左图右文 + 底部操作按钮）
 * 页面级滚动由 .page-container 接管
 */

page {
  height: 100%;
  overflow: hidden;
}

.page-container {
  height: 100vh;
  overflow-y: auto;
  background: var(--color-bg-page);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
}

/* ============================================
   状态筛选 Tab（吸顶）
   ============================================ */
.status-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border-light);
}

.stab {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.stab-active {
  color: var(--color-primary);
  font-weight: 600;
}

.stab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%) scaleX(0);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  transition: transform 0.2s;
}

.stab-active .stab-line {
  transform: translateX(-50%) scaleX(1);
}

/* ============================================
   发布列表卡片
   ============================================ */
.pub-list {
  padding: 24rpx 24rpx 0;
}

.pub-card {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid var(--color-border-light);
}

/* ---- 上半部分：左图右文 ---- */
.pc-main {
  display: flex;
  gap: 20rpx;
}

.pc-img-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.pc-img {
  width: 100%;
  height: 100%;
}

/* 已完成遮罩 */
.pc-done-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pc-done-mask text {
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.pc-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pc-title-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

/* 类型标签 */
.pc-type {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-top: 4rpx;
}

.pc-type-found {
  background: var(--color-success);
}

.pc-type-lost {
  background: var(--color-warning);
}

.pc-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 地点行 */
.pc-loc-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.pc-loc-pin {
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid var(--color-text-placeholder);
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  flex-shrink: 0;
}

.pc-loc {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 时间 + 浏览量 */
.pc-meta-row {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pc-time,
.pc-views {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

/* ---- 下半部分：操作按钮 ---- */
.pc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.pc-act-btn {
  height: 60rpx;
  padding: 0 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s;
}

.pc-act-btn:active {
  opacity: 0.7;
}

.pc-act-delete {
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.pc-act-finish {
  color: #ffffff;
  font-weight: 500;
  background: linear-gradient(135deg, #4a90d9 0%, #5ba0e8 100%);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.25);
}

/* ============================================
   列表底部提示
   ============================================ */
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 16rpx 0 40rpx;
}

.list-footer-line {
  width: 60rpx;
  height: 1rpx;
  background: var(--color-border);
}

.list-footer-text {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

/* ============================================
   空状态
   ============================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx dashed var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-line {
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-border);
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
  margin-bottom: 40rpx;
}

.empty-btn {
  height: 76rpx;
  padding: 0 64rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #ffffff;
  background: linear-gradient(135deg, #4a90d9 0%, #5ba0e8 100%);
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 217, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn:active {
  opacity: 0.85;
}
