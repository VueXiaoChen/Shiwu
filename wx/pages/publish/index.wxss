/**
 * 发布页样式 — 淡色极简风
 */

.page {
  /* 全局 page 关闭了页面级滚动（overflow: hidden），由本容器接管滚动 */
  height: 100vh;
  overflow-y: auto;
  padding: 20rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ============================================
   类型切换
   ============================================ */
.type-switch {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  background: var(--color-bg-card);
  border: 2rpx solid var(--color-border-light);
  border-radius: var(--radius-lg);
  transition: all 0.2s;
}

.type-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
}

.type-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

/* 寻物选中 — 淡橙 */
.type-option-lost {
  background: #fff9f4;
  border-color: #e8a87c;
}

.type-option-lost .type-name {
  color: #d4661a;
}

.type-option-lost .type-desc {
  color: #d4661a;
  opacity: 0.7;
}

/* 招领选中 — 淡绿 */
.type-option-found {
  background: #f4fbf6;
  border-color: #8fce9f;
}

.type-option-found .type-name {
  color: #389e0d;
}

.type-option-found .type-desc {
  color: #389e0d;
  opacity: 0.7;
}

/* ============================================
   表单卡片
   ============================================ */
.form-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.form-group {
  padding: 4rpx 0;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.form-label-tip {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

.form-label-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  font-weight: 400;
}

.required {
  color: var(--color-danger);
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 220rpx;
  padding: 20rpx 24rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

.form-ph {
  color: var(--color-text-placeholder);
  font-size: 27rpx;
}

/* 行式表单项（picker 触发行） */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.form-col {
  display: flex;
  flex-direction: column;
}

.form-row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.form-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
}

/* CSS 手绘右箭头 */
.row-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--color-text-placeholder);
  border-right: 3rpx solid var(--color-text-placeholder);
  transform: rotate(45deg);
}

.divider-thin {
  margin: 16rpx 0;
}

/* ============================================
   图片上传
   ============================================ */
.upload-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item {
  position: relative;
  width: 192rpx;
  height: 192rpx;
}

.upload-img {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-md);
}

/* 删除角标（CSS 手绘 ×） */
.upload-remove {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-x1,
.remove-x2 {
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: #ffffff;
  border-radius: 2rpx;
}

.remove-x1 {
  transform: rotate(45deg);
}

.remove-x2 {
  transform: rotate(-45deg);
}

/* 添加按钮 */
.upload-add {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-add:active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
}

/* CSS 手绘加号 */
.add-plus-h {
  width: 40rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--color-text-placeholder);
}

.add-plus-v {
  width: 5rpx;
  height: 40rpx;
  border-radius: 3rpx;
  background: var(--color-text-placeholder);
  margin-top: -22rpx;
}

.upload-add-text {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* ============================================
   开关（CSS 手绘 switch）
   ============================================ */
.switch {
  width: 92rpx;
  height: 52rpx;
  border-radius: var(--radius-full);
  background: var(--color-border);
  padding: 4rpx;
  box-sizing: border-box;
  transition: background 0.2s;
  flex-shrink: 0;
}

.switch-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.2s;
}

.switch-on {
  background: var(--color-danger);
}

.switch-on .switch-dot {
  transform: translateX(40rpx);
}

/* ============================================
   提交按钮
   ============================================ */
.submit-wrap {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-full);
  transition: opacity 0.15s, transform 0.15s;
}

.submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 寻物 — 暖橙 */
.submit-btn-lost {
  background: #e07b39;
  box-shadow: 0 6rpx 20rpx rgba(224, 123, 57, 0.25);
}

/* 招领 — 柔绿 */
.submit-btn-found {
  background: #52a463;
  box-shadow: 0 6rpx 20rpx rgba(82, 164, 99, 0.25);
}

.submit-tip {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}
