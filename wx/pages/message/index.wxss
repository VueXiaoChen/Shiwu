/**
 * 消息中心样式 — 淡色极简风
 */

.page {
  /* 全局 page 关闭了页面级滚动（overflow: hidden），由本容器接管滚动 */
  height: 100vh;
  overflow-y: auto;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ============================================
   未登录状态
   ============================================ */
.unlogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

/* CSS 手绘气泡图标 */
.unlogin-icon {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 36rpx;
}

.unlogin-bubble {
  width: 120rpx;
  height: 96rpx;
  border: 6rpx solid var(--color-border);
  border-radius: 28rpx 28rpx 28rpx 6rpx;
  box-sizing: border-box;
}

.unlogin-dot-row {
  position: absolute;
  top: 40rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

.unlogin-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-text-placeholder);
}

.unlogin-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.unlogin-sub {
  font-size: 25rpx;
  color: var(--color-text-muted);
  margin-bottom: 48rpx;
}

.unlogin-btn {
  width: 320rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 29rpx;
  color: #fff;
  background: var(--color-primary);
  border-radius: var(--radius-full, 999rpx);
  padding: 0;
}

.unlogin-btn::after {
  border: none;
}

/* ============================================
   消息卡片列表
   ============================================ */
.msg-list {
  padding: 20rpx 24rpx 0;
}

.msg-card {
  display: flex;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg, 16rpx);
}

/* 头像 + 未读红点 */
.msg-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  margin-right: 22rpx;
}

.msg-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--color-bg-page);
}

.msg-unread-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-danger);
  border: 3rpx solid var(--color-bg-card);
}

/* 消息主体 */
.msg-body {
  flex: 1;
  min-width: 0;
}

.msg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.msg-name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.msg-time {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.msg-content {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  word-break: break-all;
}

/* 关联物品引用条 */
.msg-item-ref {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-sm, 6rpx);
}

.msg-item-ref-bar {
  width: 5rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  margin-right: 12rpx;
  flex-shrink: 0;
}

.msg-item-ref-text {
  font-size: 23rpx;
  color: var(--color-text-muted);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============================================
   空状态（与首页风格一致）
   ============================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0 60rpx;
}

.empty-icon-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border: 5rpx solid var(--color-border);
  border-radius: 50%;
  margin-bottom: 28rpx;
}

.empty-icon-line {
  width: 44rpx;
  height: 5rpx;
  border-radius: 3rpx;
  background: var(--color-border);
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

/* ============================================
   列表底部提示
   ============================================ */
.list-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.list-footer-line {
  width: 60rpx;
  height: 1rpx;
  background: var(--color-border);
}

.list-footer-text {
  font-size: 23rpx;
  color: var(--color-text-placeholder);
  margin: 0 20rpx;
}
