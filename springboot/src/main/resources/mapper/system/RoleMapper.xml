<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.system.mapper.RoleMapper">

    <resultMap id="RoleResult" type="Role">
        <id property="roleId" column="role_id"/>
        <result property="roleName" column="role_name"/>
        <result property="roleSort" column="role_sort"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!--查询角色列表（带分页）-->
    <select id="selectRoleList" resultMap="RoleResult">
        select role_id, role_name, role_sort, remark, create_time
        from role
        <where>
            <if test="role.roleId != null">
                and role_id = #{role.roleId}
            </if>
            <if test="role.roleName != null and role.roleName != ''">
                and role_name like concat('%', #{role.roleName} ,'%')
            </if>
        </where>
        order by role_sort
    </select>

</mapper>
