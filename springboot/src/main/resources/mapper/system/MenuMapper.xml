<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fast.system.mapper.MenuMapper">
    <resultMap id="MenuResult" type="Menu">
        <id property="menuId" column="menu_id"/>
        <result property="menuName" column="menu_name"/>
        <result property="parentId" column="parent_id"/>
        <result property="menuSort" column="menu_sort"/>
        <result property="path" column="path"/>
        <result property="component" column="component"/>
        <result property="menuType" column="menu_type"/>
        <result property="icon" column="icon"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <!--根据用户ID查询菜单列表-->
    <select id="selectMenuListByUserId" resultMap="MenuResult" parameterType="Menu">
        select distinct m.menu_id, m.menu_name, m.parent_id, m.menu_sort, m.path, m.component,
               m.menu_type, m.icon, m.create_time
        from menu m
        left join role_menu rm on m.menu_id = rm.menu_id
        left join user u on rm.role_id = u.role_id
        <where>
            <if test="userId != null">
                and u.user_id = #{userId}
            </if>
            <if test="menuName != null and menuName != ''">
                and m.menu_name like concat('%', #{menuName} ,'%')
            </if>
        </where>
        order by m.parent_id, m.menu_sort
    </select>

    <!--根据角色ID查询对应菜单树-->
    <select id="selectMenuListByRoleId" resultType="Long">
        select m.menu_id
        from menu m
        left join role_menu rm on m.menu_id = rm.menu_id
        where rm.role_id = #{roleId}
        order by m.parent_id, m.menu_sort
    </select>

</mapper>
